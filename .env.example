# Copy this file to .env (gitignored) and fill in real values.
# Anything prefixed NEXT_PUBLIC_ is exposed in the built bundle.
# Anything without that prefix only reaches Node build scripts (postbuild).
#
# Every variable here is OPTIONAL. The site builds and deploys without any
# of them set — the affected feature just degrades silently.

# Canonical site URL — used for OG tags, sitemap, RSS, BibTeX, llms.txt.
# Defaults to https://juyoung.site (see lib/site.ts).
NEXT_PUBLIC_SITE_URL=

# Buttondown newsletter username. When set, NewsletterSignup renders the
# embed form under each blog post. Get from https://buttondown.com.
NEXT_PUBLIC_BUTTONDOWN_USERNAME=

# Search-console verification tokens. When set, SEO.tsx emits the matching
# <meta name="..."> tag site-wide. Get one each from:
#   https://search.google.com/search-console
#   https://www.bing.com/webmasters
#   https://searchadvisor.naver.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# Umami admin credentials. Read by scripts/build-views.mjs (postbuild) to
# fetch per-post pageview counts from the self-hosted Umami instance.
# Without these the view-count component renders nothing.
UMAMI_USERNAME=
UMAMI_PASSWORD=

# Note: Umami script URL + website ID and Giscus repo/category IDs are
# hardcoded as public constants in source (pages/_document.tsx,
# components/blog/Comments.tsx). They are not secrets, so they live in
# git rather than .env.
