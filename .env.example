# Copy this file to .env (which is gitignored) and fill in real values.
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser at build time.
# Secrets without that prefix stay server-side only (Node scripts, build hooks).

# Public site URL — used for canonical URLs, OG tags, sitemap, RSS.
NEXT_PUBLIC_SITE_URL=https://juyoung.site

# Umami analytics (P0 — self-hosted instance)
# Fill these in once Umami is deployed.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Giscus comments (P1)
# Get these from https://giscus.app after enabling GitHub Discussions on the repo.
NEXT_PUBLIC_GISCUS_REPO=juyoungml/juyoungml.github.io
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Newsletter (P1) — Buttondown form action URL or Substack embed ID.
NEXT_PUBLIC_NEWSLETTER_URL=

# AWS — DO NOT put credentials here. AWS CLI reads them from ~/.aws/credentials
# (set up by `aws configure`). If you ever need a per-project profile, use:
#   AWS_PROFILE=juyoung-site
