{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/build-sitemap.mjs && node scripts/build-feeds.mjs && node scripts/build-llms.mjs && node scripts/build-og-images.mjs && pagefind --site out --output-subdir pagefind",
    "start": "next start",
    "export": "next build",
    "deploy": "npm run build && touch out/.nojekyll",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "cv:build": "cd cv && ./build.sh",
    "cv:extract": "cd cv && uv run extract-data.py",
    "cv:sync": "npm run cv:extract && npm run cv:build"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^14.2.31",
    "next-mdx-remote": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.17.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "satori": "^0.26.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
